# Everything the published package does not need. The tarball holds the modules the exports reach, as .js and
# .d.ts in dist/, with LICENSE, NOTICE, README.md and package.json; test/license.test.ts fails on anything else.
# package.json has no "files" list: npm and pnpm ignore a root .npmignore when it does.

# Sources, tests and the tools that build them
/src/
/test/
/build/
/scripts/
/tsconfig*.json

# The vendored contract, the conformance run and its report: they run from a checkout, not an install
/vendor/
/conformance-report.json
/dist/cli/
/dist/conformance.*
/dist/implementation.*

# Source maps point at src/, which is not published
*.map

# Repository and editor files
/.github/
/.claude/
/.codex/
/.serena/
/.mcp.json
/.gitignore
/.npmignore
/AGENTS.md
/cliff.toml
/pnpm-lock.yaml
/node_modules/
*.tgz

# Examples run from a checkout, through the tests
/examples/
